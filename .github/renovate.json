{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "packageRules": [
    {
      "description": "Ignore internal images built within this repository",
      "enabled": false,
      "matchPackageNames": [
        "/^quay\\.io/caracan//"
      ]
    },
    {
      "description": "Disable major updates for docker images",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Pin digests for external container images",
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true
    }
  ]
}
