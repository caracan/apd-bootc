FROM quay.io/caracan/apd-base:latest@sha256:364cead585aa969d0e93a8e55ddadd3314e0cb65050374f37a6436c2a539a8f1

RUN echo "qemu:x:107:107:qemu user:/:/sbin/nologin" >> /etc/passwd && \
      dnf -y install qemu-kvm libvirt virt-install virt-viewer cockpit-machines && \
      systemctl enable libvirt-guests && \
      dnf clean all; \
      rm -rf /var/log/dnf5.log* /var/lib/dnf/ /var/cache/ibdnf5/;
	  
RUN bootc container lint
