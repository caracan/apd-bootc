#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

build_service() {
  local dir="$1"
  local image_name="$2"

  echo "==> Building $image_name in $dir..."
  cd "$SCRIPT_DIR/$dir"

  local version major minor
  version=$(jq -r '.major + "." + .minor + "." + .zstream' version.json)
  major=$(jq -r '.major' version.json)
  minor=$(jq -r '.minor' version.json)

  podman build --pull=newer \
    -f Containerfile \
    -t "quay.io/caracan/${image_name}:latest" \
    -t "quay.io/caracan/${image_name}:${major}" \
    -t "quay.io/caracan/${image_name}:${major}.${minor}" \
    -t "quay.io/caracan/${image_name}:${version}" \
    .

  echo "Successfully built quay.io/caracan/${image_name}:${version} (and :${major}, :latest)"
}

build_service "base" "apd-base"
build_service "virt-host" "apd-virt-host"
build_service "virt-guest" "apd-virt-guest"
build_service "dev" "apd-dev"

echo "==> All images built successfully!"
