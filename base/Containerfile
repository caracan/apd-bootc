FROM quay.io/fedora/fedora-bootc:44@sha256:8f9759e6bd30214e9bbb422eb46f27db8d44614c0ccbca61fa645abd2e0f7275 

RUN dnf -y install NetworkManager openssh-server sudo firewalld podman cockpit cockpit-podman acl systemd-container nfs-utils wget bash-color-prompt tuned; \ 
        dnf -y install --allowerasing vim-default-editor.noarch; \
	dnf clean all; \
	systemctl enable cockpit.socket; \
	systemctl enable tuned; \
	systemctl mask bootc-fetch-apply-updates.timer; \
	echo "throughput-performance" > /etc/tuned/active_profile; \
        firewall-offline-cmd --add-service cockpit; \
        rm /var/{log,cache,lib}/* -rf

COPY --chmod=0440 wheel-nopasswd /etc/sudoers.d/wheel-nopasswd
COPY --chmod=0644 10-machinectl.rules /etc/polkit-1/rules.d/10-machinectl.rules
