
FROM quay.io/fedora/fedora-bootc:43@sha256:727936e425f6cbebd94756c5e76501445392ebca9c50bdaa754738aa0fec5de1

RUN dnf -y install NetworkManager openssh-server sudo firewalld podman cockpit cockpit-podman acl systemd-container nfs-utils wget; \
	dnf clean all; \
	systemctl enable cockpit.socket; \
        firewall-offline-cmd --add-service cockpit; \
        rm /var/{log,cache,lib}/* -rf

COPY wheel-nopasswd /etc/sudoers.d