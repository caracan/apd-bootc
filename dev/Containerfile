FROM quay.io/caracan/apd-virt-host:latest@sha256:7403cf035cb05a76131be5f47a3a1385e19d6afaff250aa6ddaebf01cb5c65df

RUN curl --fail --retry 15 --retry-all-errors -sSL https://pkgs.tailscale.com/stable/fedora/tailscale.repo -o /etc/yum.repos.d/tailscale.repo;\ 
    dnf -y install git ansible ansible-lint buildah skopeo tmux nmap tailscale podman-comopse; \
    dnf clean all; \
    rm -rf /var/log/dnf5.log* /var/lib/dnf/ /var/cache/libdnf5/;

RUN bootc container lint
